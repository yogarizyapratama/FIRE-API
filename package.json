{
  "name": "@tamayrp14/fire-api",
  "version": "1.0.3",
  "description": "Ultra-lightweight, blazing-fast, type-safe API framework with universal DB, security shield, turnkey auth, express compat, dev studio, and native AI/MCP integration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "fire-api": "./bin/fire.mjs",
    "fire": "./bin/fire.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yogarizyapratama/FIRE-API.git"
  },
  "homepage": "https://github.com/yogarizyapratama/FIRE-API#readme",
  "bugs": {
    "url": "https://github.com/yogarizyapratama/FIRE-API/issues"
  },
  "author": "Yoga Rizya Pratama",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./auth": {
      "import": "./dist/auth/auth.js",
      "types": "./dist/auth/auth.d.ts"
    },
    "./compat": {
      "import": "./dist/compat/express.js",
      "types": "./dist/compat/express.d.ts"
    },
    "./studio": {
      "import": "./dist/studio/studio.js",
      "types": "./dist/studio/studio.d.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "build": "bun build ./bin/fire.js --outfile ./bin/fire.mjs --target node --format esm && chmod +x ./bin/fire.mjs && bun build ./src/index.ts ./src/client.ts ./src/auth/auth.ts ./src/compat/express.ts ./src/studio/studio.ts --outdir ./dist --target node && tsc --module ESNext --moduleResolution bundler --declaration --emitDeclarationOnly --outDir dist",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "framework",
    "api",
    "typescript",
    "fast",
    "bun",
    "node",
    "mcp",
    "sqlite",
    "postgres",
    "auth",
    "studio",
    "rest"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
