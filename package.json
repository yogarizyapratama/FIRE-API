{
  "name": "fire-api",
  "version": "1.0.0",
  "description": "Ultra-lightweight, blazing-fast, type-safe API framework with universal DB, security shield, turnkey auth, express compat, dev studio, and native AI/MCP integration",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "bin": {
    "fire-api": "./bin/fire.js",
    "fire": "./bin/fire.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./client": {
      "import": "./src/client.ts",
      "types": "./src/client.ts"
    },
    "./auth": {
      "import": "./src/auth/auth.ts",
      "types": "./src/auth/auth.ts"
    },
    "./compat": {
      "import": "./src/compat/express.ts",
      "types": "./src/compat/express.ts"
    },
    "./studio": {
      "import": "./src/studio/studio.ts",
      "types": "./src/studio/studio.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "framework",
    "api",
    "typescript",
    "fast",
    "bun",
    "node",
    "mcp",
    "sqlite",
    "postgres",
    "auth",
    "studio",
    "rest"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
